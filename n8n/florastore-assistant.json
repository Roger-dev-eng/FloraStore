{
  "id": "FloraAssistantRag",
  "name": "FloraStore - Assistente com Supabase pgvector e Groq",
  "active": false,
  "nodes": [
    {
      "id": "receive",
      "name": "Pergunta do cliente",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "webhookId": "flora-assistant-webhook",
      "parameters": {
        "httpMethod": "POST",
        "path": "florastore-assistant",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "floraAssistantHeader",
          "name": "FloraStore local"
        }
      }
    },
    {
      "id": "retrieve",
      "name": "Buscar vetores no Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        280,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8001/retrieve",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.body }}",
        "options": {
          "timeout": 60000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "floraAssistantHeader",
          "name": "FloraStore local"
        }
      }
    },
    {
      "id": "answer",
      "name": "Gerar resposta com Groq",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        560,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8001/answer",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { request_id: $json.request_id } }}",
        "options": {
          "timeout": 45000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "floraAssistantHeader",
          "name": "FloraStore local"
        }
      }
    },
    {
      "id": "respond",
      "name": "Responder ao cliente",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        840,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Pergunta do cliente": {
      "main": [
        [
          {
            "node": "Buscar vetores no Supabase",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Buscar vetores no Supabase": {
      "main": [
        [
          {
            "node": "Gerar resposta com Groq",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gerar resposta com Groq": {
      "main": [
        [
          {
            "node": "Responder ao cliente",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "all",
    "saveDataErrorExecution": "all"
  }
}
